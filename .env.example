APP_NAME="Bank Complaint Manager"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_TIMEZONE=Asia/Karachi

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Configuration (MySQL / MariaDB recommended for cPanel)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_cpanel_db
DB_USERNAME=your_cpanel_user
DB_PASSWORD=your_cpanel_password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Email Integration (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="CMS Technical Operations Desk"
MAIL_HOST_DOMAIN="yourdomain.com"
MAIL_AUTO_BCC_SENDER=true

# Email Ingestion (IMAP Webmail)
IMAP_HOST="mail.yourdomain.com"
IMAP_PORT="993"
IMAP_ENCRYPTION="ssl"
IMAP_USERNAME="noreply@yourdomain.com"
IMAP_PASSWORD="your_email_password"

# Gemini AI Integration (for complaint triage and routing)
GEMINI_API_KEY=""

# Webhook & WhatsApp Integration
N8N_WEBHOOK_SECRET=your_custom_secret_key
WWEBJS_SERVICE_URL=http://localhost:3000
WHATSAPP_GROUP_INVITE_URL=https://chat.whatsapp.com/your_group_invite
